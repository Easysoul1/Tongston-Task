# Environment variables
# Copy this file to .env and fill in real values.
# MONGO_URI must be MongoDB Atlas (replica set) for transactions - see Fix 1.
MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/tongston?retryWrites=true&w=majority

# Cloudinary (media upload)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# AWS S3 (optional, for media promotion)
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
AWS_REGION=us-east-1
AWS_S3_BUCKET=your_bucket

# AI provider (optional; MockAIProvider used by default)
AI_API_KEY=optional_openai_key

# Auth
JWT_SECRET=change_this_to_a_strong_secret

# CORS
CORS_ORIGIN=http://localhost:5173

# Port
PORT=3000